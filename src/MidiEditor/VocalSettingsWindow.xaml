<Window x:Class="MidiEditor.VocalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseGrid 보컬 설정" Width="720" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#151A22" Foreground="#E7ECF3">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="OPENUTAU / VOCAL" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,5,0,18" Foreground="#93A0B2" TextWrapping="Wrap"
                   Text="OpenUtau 실행 파일과 UTAU 호환 보이스뱅크 경로를 지정합니다. resampler/wavtool 경로는 OpenUtau로 넘기는 UST 설정에 기록됩니다." />

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
            <TextBlock Text="보이스뱅크 PATH" VerticalAlignment="Center" />
            <TextBox x:Name="VoicebankRootBox" Grid.Column="1" Height="30" Margin="8,0" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="찾기…" Click="BrowseVoicebank_Click" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
            <TextBlock Text="OpenUtau.exe" VerticalAlignment="Center" />
            <TextBox x:Name="OpenUtauBox" Grid.Column="1" Height="30" Margin="8,0" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="찾기…" Click="BrowseOpenUtau_Click" />
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="resampler" />
                <TextBlock Text="(선택 사항)" FontSize="9" Foreground="#7D8A9C" />
            </StackPanel>
            <TextBox x:Name="ResamplerBox" Grid.Column="1" Height="30" Margin="8,0" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="찾기…" Click="BrowseResampler_Click" />
        </Grid>
        <Grid Grid.Row="5" VerticalAlignment="Top">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="wavtool" />
                <TextBlock Text="(선택 사항)" FontSize="9" Foreground="#7D8A9C" />
            </StackPanel>
            <TextBox x:Name="WavtoolBox" Grid.Column="1" Height="30" Margin="8,0" VerticalContentAlignment="Center" />
            <Button Grid.Column="2" Content="찾기…" Click="BrowseWavtool_Click" />
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="88" Height="32" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="저장" Width="88" Height="32" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
