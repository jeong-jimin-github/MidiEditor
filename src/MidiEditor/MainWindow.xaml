<Window x:Class="MidiEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MidiEditor.Controls"
        mc:Ignorable="d"
        Title="PulseGrid MIDI Studio" Width="1440" Height="900" MinWidth="1040" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#0D1015"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Border BorderBrush="#3A424F" BorderThickness="1" Background="{StaticResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
                <RowDefinition Height="27" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="#151922" BorderBrush="#2B323D" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border Width="25" Height="25" CornerRadius="7" Background="#63D5A7">
                            <TextBlock Text="♪" Foreground="#12241E" FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="PULSEGRID" Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Width="1" Height="15" Background="#3B4452" Margin="12,0" />
                        <TextBlock x:Name="TitleProjectText" Text="Untitled Groove" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="MIDI STUDIO" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="9" FontWeight="SemiBold" Foreground="#687386" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButton}" Content="—" Width="42" Height="37" Padding="0"
                                FontFamily="Segoe UI" Click="MinimizeButton_Click" ToolTip="최소화" />
                        <Button Style="{StaticResource ToolbarButton}" Content="□" Width="42" Height="37" Padding="0"
                                FontFamily="Segoe UI" Click="MaximizeButton_Click" ToolTip="최대화/복원" />
                        <Button Style="{StaticResource ToolbarButton}" Content="×" Width="46" Height="37" Padding="0"
                                FontFamily="Segoe UI" FontSize="18" Click="CloseButton_Click" ToolTip="닫기" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Transport -->
            <Border Grid.Row="1" Background="#1A1F28" BorderBrush="#303844" BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolbarButton}" Content="↤" Click="RewindButton_Click" ToolTip="처음으로 (Home)" />
                        <Button Style="{StaticResource ToolbarButton}" Content="■" Margin="3,0" Click="StopButton_Click" ToolTip="정지" />
                        <Button x:Name="PlayButton" Style="{StaticResource AccentButton}" Content="▶" Width="44"
                                Click="PlayButton_Click" ToolTip="재생/일시정지 (Space)" />
                    </StackPanel>

                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="6" Background="#11151C" BorderBrush="#303844" BorderThickness="1"
                            Padding="12,7" MinWidth="126">
                        <StackPanel>
                            <TextBlock x:Name="PositionText" Text="001 : 01 : 000" FontFamily="Consolas" FontSize="15"
                                       Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="BAR      BEAT      TICK" FontSize="7" Foreground="#657184" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,13,0">
                            <TextBlock Text="TEMPO" FontSize="8" Foreground="{StaticResource MutedTextBrush}" />
                            <Border Background="#11151C" BorderBrush="#303844" BorderThickness="1" CornerRadius="5" Margin="0,3,0,0">
                                <TextBox x:Name="TempoBox" Width="64" BorderThickness="0" Background="Transparent" TextAlignment="Center"
                                         FontFamily="Consolas" FontSize="13" LostKeyboardFocus="TempoBox_Commit" KeyDown="TempoBox_KeyDown" />
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,13,0">
                            <TextBlock Text="SNAP" FontSize="8" Foreground="{StaticResource MutedTextBrush}" />
                            <ComboBox x:Name="SnapCombo" Width="78" Height="29" Margin="0,3,0,0" SelectionChanged="SnapCombo_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="SIGNATURE" FontSize="8" Foreground="{StaticResource MutedTextBrush}" />
                            <Border Height="29" Margin="0,3,0,0" Background="#202630" BorderBrush="#343C49" BorderThickness="1" CornerRadius="4" Padding="10,0">
                                <TextBlock x:Name="SignatureText" Text="4 / 4" VerticalAlignment="Center" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <ToggleButton x:Name="LoopToggle" Style="{StaticResource IconToggle}" Width="39" Height="30" Content="LOOP"
                                      FontSize="9" Margin="0,14,0,0" Checked="LoopToggle_Changed" Unchecked="LoopToggle_Changed"
                                      PreviewMouseLeftButtonDown="HistoryToggle_PreviewMouseLeftButtonDown"
                                      PreviewKeyDown="HistoryToggle_PreviewKeyDown" ToolTip="루프 (L)" />
                        <ToggleButton x:Name="FollowToggle" Style="{StaticResource IconToggle}" Width="52" Height="30" Content="FOLLOW"
                                      FontSize="8.5" Margin="4,14,0,0" IsChecked="False" ToolTip="재생바 자동 따라가기" />
                    </StackPanel>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PillButton}" Content="새 프로젝트" Click="NewButton_Click" />
                        <Button Style="{StaticResource PillButton}" Content="열기" Margin="6,0,0,0" Click="OpenProjectButton_Click" />
                        <Button Style="{StaticResource PillButton}" Content="저장" Margin="6,0,0,0" Click="SaveProjectButton_Click" />
                        <Border Width="1" Height="24" Background="#38414E" Margin="10,0" />
                        <Button Style="{StaticResource PillButton}" Content="MIDI 가져오기" Click="ImportMidiButton_Click" />
                        <Button Style="{StaticResource PillButton}" Content="MIDI 내보내기" Margin="6,0,0,0" Click="ExportMidiButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Workspace -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" MinWidth="220" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Track browser -->
                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#303844" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="47" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="338" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="13,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TRACKS" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock x:Name="TrackCountText" Text="4 tracks" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ToolbarButton}" Content="＋" Width="31" Height="29" Padding="0"
                                        FontFamily="Segoe UI" Click="AddInstrumentButton_Click" ToolTip="악기 트랙 추가" />
                                <Button Style="{StaticResource ToolbarButton}" Content="▦" Width="31" Height="29" Padding="0" Margin="3,0,0,0"
                                        FontFamily="Segoe UI Symbol" Click="AddDrumButton_Click" ToolTip="드럼 트랙 추가" />
                                <Button Style="{StaticResource ToolbarButton}" Content="V" Width="31" Height="29" Padding="0" Margin="3,0,0,0"
                                        FontFamily="Segoe UI" FontWeight="Bold" Click="AddVocalButton_Click" ToolTip="OpenUtau 보컬 트랙 추가" />
                                <Button Style="{StaticResource ToolbarButton}" Content="⚙" Width="31" Height="29" Padding="0" Margin="3,0,0,0"
                                        FontFamily="Segoe UI Symbol" Click="VocalSettingsButton_Click" ToolTip="보컬/OpenUtau 설정" />
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="TrackListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="7,0"
                                 SelectionChanged="TrackListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Resources>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Card" Background="#20252F" CornerRadius="6" BorderBrush="#2C333E" BorderThickness="1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="#262C37" />
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#414B5A" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="#293B39" />
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="#5EC79E" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="54">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding Color}" CornerRadius="5,0,0,5" />
                                        <Grid Grid.Column="1" Margin="10,6,5,5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="8" Foreground="#8EA0B4" FontWeight="SemiBold" />
                                                <TextBlock Text=" · " FontSize="8" Foreground="#566274" />
                                                <TextBlock Text="{Binding ProgramLabel}" FontSize="8.5" Foreground="#7E899A" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                                            <ToggleButton Style="{StaticResource IconToggle}" Content="M" IsChecked="{Binding IsMuted}" Click="TrackToggle_Click"
                                                          PreviewMouseLeftButtonDown="HistoryToggle_PreviewMouseLeftButtonDown" PreviewKeyDown="HistoryToggle_PreviewKeyDown" ToolTip="Mute" />
                                            <ToggleButton Style="{StaticResource IconToggle}" Content="S" IsChecked="{Binding IsSolo}" Click="TrackToggle_Click"
                                                          PreviewMouseLeftButtonDown="HistoryToggle_PreviewMouseLeftButtonDown" PreviewKeyDown="HistoryToggle_PreviewKeyDown" ToolTip="Solo" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Selected track / SoundFont inspector -->
                        <Border Grid.Row="2" Margin="8,6,8,8" Background="#151A22" BorderBrush="#2E3642" BorderThickness="1" CornerRadius="7">
                            <Grid Margin="11,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SELECTED TRACK" FontSize="9" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="×" Width="25" Height="22" Padding="0"
                                            FontFamily="Segoe UI" Click="DeleteTrackButton_Click" ToolTip="트랙 삭제" />
                                </Grid>
                                <TextBox x:Name="TrackNameBox" Grid.Row="1" Height="29" Margin="0,7,0,0" LostKeyboardFocus="TrackNameBox_Commit" />
                                <Grid Grid.Row="2" Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ProgramCombo" Height="29" SelectionChanged="ProgramCombo_SelectionChanged" />
                                    <ComboBox x:Name="ChannelCombo" Grid.Column="1" Height="29" Margin="6,0,0,0" SelectionChanged="ChannelCombo_SelectionChanged" ToolTip="MIDI 채널" />
                                </Grid>
                                <StackPanel x:Name="VocalInspectorPanel" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock Text="VOCAL / OPENUTAU" FontSize="9" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" />
                                    <ComboBox x:Name="VoicebankCombo" Height="29" Margin="0,6,0,0" SelectionChanged="VoicebankCombo_SelectionChanged" ToolTip="이 보컬 트랙의 보이스뱅크" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="LYRIC" FontSize="9" Foreground="#8491A3" VerticalAlignment="Center" />
                                        <TextBox x:Name="LyricBox" Grid.Column="1" Height="27" VerticalContentAlignment="Center"
                                                 LostKeyboardFocus="LyricBox_Commit" KeyDown="LyricBox_KeyDown" ToolTip="선택한 보컬 노트의 가사/alias" />
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button x:Name="VocalPreviewButton" Style="{StaticResource PillButton}" Content="빠른 미리듣기" Height="30" Click="VocalPreviewButton_Click" />
                                        <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="OpenUtau 열기" Height="30" Margin="5,0,0,0" Click="OpenUtauButton_Click" />
                                    </Grid>
                                </StackPanel>
                                <Grid Grid.Row="4" Margin="0,11,0,0" VerticalAlignment="Bottom">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="SOUNDFONT ENGINE" FontSize="9" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" />
                                        <Ellipse x:Name="SoundFontDot" Grid.Column="1" Width="7" Height="7" Fill="#FF6673" VerticalAlignment="Center" />
                                    </Grid>
                                    <Button x:Name="SoundFontButton" Grid.Row="1" Style="{StaticResource PillButton}" Height="34" Margin="0,7,0,0"
                                            Content="SF2 불러오기" Click="SoundFontButton_Click" HorizontalContentAlignment="Left" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#11151C" />

                <!-- Arrangement and editor -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="218" MinHeight="150" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" MinHeight="300" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions><RowDefinition Height="35" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="#1A1F28" BorderBrush="#303844" BorderThickness="0,0,0,1">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="PLAYLIST" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Text="  ·  all tracks" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+wheel: H zoom  ·  Shift+wheel: timeline  ·  wheel: tracks" VerticalAlignment="Center"
                                               FontSize="8.5" Foreground="#6E7B8E" Margin="0,0,12,0" />
                                    <TextBlock Text="V ZOOM" FontSize="8" Foreground="#748195" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Slider x:Name="ArrangementVerticalZoomSlider" Width="76" Minimum="24" Maximum="72" Value="37"
                                            ValueChanged="ArrangementVerticalZoom_ValueChanged" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="16" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                            <controls:ArrangementView x:Name="Arrangement"
                                                      TrackSelected="Arrangement_TrackSelected" SeekRequested="Editor_SeekRequested"
                                                      ViewportChanged="Viewport_Changed" />
                            <ScrollBar x:Name="ArrangementVerticalScroll" Grid.Column="1" Orientation="Vertical"
                                       ValueChanged="ViewportScroll_ValueChanged" />
                            <ScrollBar x:Name="ArrangementHorizontalScroll" Grid.Row="1" Orientation="Horizontal"
                                       ValueChanged="ViewportScroll_ValueChanged" />
                        </Grid>
                    </Grid>

                    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#303844" />

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="43" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="#1B2029" BorderBrush="#303844" BorderThickness="0,0,0,1">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PianoTabButton" Style="{StaticResource PillButton}" Content="PIANO ROLL" Click="PianoTabButton_Click" />
                                    <Button x:Name="DrumTabButton" Style="{StaticResource PillButton}" Content="DRUM PATTERN" Margin="5,0,0,0" Click="DrumTabButton_Click" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="4" Height="22" x:Name="EditorColorBar" Background="#63D5A7" CornerRadius="2" />
                                    <TextBlock x:Name="EditorTrackTitle" Text="Neon Keys" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="EditorHintText" Text="  ·  left draw/move  ·  edge resize  ·  right delete" Margin="5,0,0,0"
                                               FontSize="8.5" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="H ZOOM" FontSize="8" Foreground="#748195" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <Slider x:Name="ZoomSlider" Width="84" Minimum="24" Maximum="180" Value="62"
                                            ValueChanged="ZoomSlider_ValueChanged" />
                                    <TextBlock Text="V ZOOM" FontSize="8" Foreground="#748195" VerticalAlignment="Center" Margin="12,0,7,0" />
                                    <Slider x:Name="EditorVerticalZoomSlider" Width="76" Minimum="8" Maximum="36" Value="14"
                                            ValueChanged="EditorVerticalZoom_ValueChanged" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="16" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                            <controls:PianoRollControl x:Name="PianoRoll" Visibility="Visible"
                                                       EditStarted="Editor_EditStarted" EditFinished="Editor_EditFinished"
                                                       PreviewNote="Editor_PreviewNote" SeekRequested="Editor_SeekRequested"
                                                       SelectionChanged="Editor_SelectionChanged" ViewportChanged="Viewport_Changed" />
                            <controls:DrumPatternControl x:Name="DrumPattern" Visibility="Collapsed"
                                                        EditStarted="Editor_EditStarted" EditFinished="Editor_EditFinished"
                                                        PreviewNote="Editor_PreviewNote" SeekRequested="Editor_SeekRequested"
                                                        ViewportChanged="Viewport_Changed" />
                            <ScrollBar x:Name="EditorVerticalScroll" Grid.Column="1" Orientation="Vertical"
                                       ValueChanged="ViewportScroll_ValueChanged" />
                            <ScrollBar x:Name="EditorHorizontalScroll" Grid.Row="1" Orientation="Horizontal"
                                       ValueChanged="ViewportScroll_ValueChanged" />
                            <Border x:Name="NoTrackOverlay" Background="#E6171B23" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="트랙을 추가하면 편집을 시작할 수 있습니다" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="왼쪽 위 + 버튼은 악기, 격자 버튼은 드럼 트랙을 만듭니다" Margin="0,8,0,0"
                                               FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="#10141A" BorderBrush="#2B323D" BorderThickness="0,1,0,0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#63D5A7" Margin="0,0,7,0" />
                        <TextBlock x:Name="StatusText" Text="Ready · 왼쪽 클릭으로 노트를 그리고 Space로 재생하세요" FontSize="8.5" Foreground="#8B97A9" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="SelectionStatusText" Text="" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="8.5" Foreground="#748195" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="LanguageComboBox" Width="102" Height="22" Margin="0,0,9,0"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                  SelectionChanged="LanguageComboBox_SelectionChanged" ToolTip="표시 언어" />
                        <Border Width="1" Height="12" Background="#35404E" Margin="0,0,9,0" />
                        <TextBlock Text="44.1 kHz" FontSize="8.5" Foreground="#687487" />
                        <Border Width="1" Height="12" Background="#35404E" Margin="9,0" />
                        <TextBlock x:Name="CpuStatusText" Text="SF2 OFFLINE" FontSize="8.5" Foreground="#687487" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
